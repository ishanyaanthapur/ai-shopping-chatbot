# Copy this file to hw4/.env and fill in your key. Never commit .env.

# Portkey API key — the backend sends all model calls through the Portkey
# gateway (https://api.portkey.ai/v1) with the "openai" provider.
PORTKEY_API_KEY=your-portkey-api-key-here

# OpenAI chat model used by the shopping agent (read by backend/agent.py).
OPENAI_MODEL=gpt-5.6-luna
